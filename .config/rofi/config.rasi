configuration {
    modes: [combi,drun,run];
    combi-modes: [drun,run];
    combi-hide-mode-prefix: true;
    show-icons: true;
    font: "Noto Sans 12";
    drun-display-format: "{name}";
    display-drun: "apps";
    display-run: "run";
    display-combi: "search";
}

@theme "/dev/null"
@import "matugen.rasi"

* {
    background-color: transparent;
    text-color: @foreground;
}

window {
    location: center;
    anchor: center;
    width: 500px;
    padding: 14px;
    border-radius: 8px;
    background-color: @background;
    border: 1px;
    border-color: @outline;
}

mainbox {
    spacing: 10px;
    children: [inputbar, listview];
}

inputbar {
    padding: 10px 13px;
    spacing: 10px;
    border-radius: 8px;
    background-color: @background-alt;
    children: [prompt, entry];
}

prompt {
    text-color: @primary;
}

entry {
    text-color: @foreground;
    placeholder: "search";
    placeholder-color: @outline;
    cursor: text;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 3px;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    spacing: 10px;
    border-radius: 8px;
    text-color: @foreground-alt;
}

element selected {
    background-color: @primary;
    text-color: @on-primary;
}

element-icon {
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
