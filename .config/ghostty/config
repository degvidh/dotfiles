# --- Appearance & Window Controls ---
font-family = "JetBrainsMono Nerd Font"
theme = matugen-theme
background-opacity = 0.80
background-blur = true
gtk-single-instance = true
gtk-wide-tabs = false

gtk-custom-css = ~/.config/ghostty/style.css

# --- Window Layout Controls (Splits) ---
# Create window sections (horizontal/vertical)
keybind = alt+\=new_split:right
keybind = alt+-=new_split:down

# Move between split layouts seamlessly
#keybind = ctrl+alt+h=goto_split:left
#keybind = ctrl+alt+l=goto_split:right
#keybind = ctrl+alt+k=goto_split:up
#keybind = ctrl+alt+j=goto_split:down

# Zoom into one pane to make it fullscreen (Toggle back with same key)
#keybind = alt+z=toggle_split_zoom

# --- Multi-Tab Management ---
keybind = alt+n=new_tab
keybind = alt+h=previous_tab
keybind = alt+l=next_tab
keybind = alt+w=close_surface

# --- Window Spacing & Margins ---
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

custom-shader = shaders/cursor_smear.glsl
