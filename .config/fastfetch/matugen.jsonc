{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

    "logo": {
        "type": "small"
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#c8bfff"
            }
        },
        "separator",
        {
            "type": "os",
            "key": {
                "color": "#c8bfff"
            }
        },
        {
            "type": "host",
            "key": {
                "color": "#c8bfff"
            }
        },
        {
            "type": "packages",
            "key": {
                "color": "#c8bfff"
            }
        },
        {
            "type": "cpu",
            "key": {
                "color": "#c8bfff"
            }
        },
        {
            "type": "gpu",
            "key": {
                "color": "#c8bfff"
            }
        },
        {
            "type": "physicalmemory",
            "key": {
                "color": "#c8bfff"
            }
        },
        {
            "type": "swap",
            "key": {
                "color": "#c8bfff"
            }
        },
        {
            "type": "disk",
            "key": {
                "color": "#c8bfff"
            }
        },
        "break",
        "colors"
    ]
}
