# Temă completă Fish generată automat de Matugen
set -g fish_color_normal #e5e1e9
set -g fish_color_command #c8bfff --bold
set -g fish_color_keyword #ecb8ce
set -g fish_color_quote #c9c3dc
set -g fish_color_redirection #c9c3dc
set -g fish_color_end #928f99

# Aici fortam vizibilitatea erorilor: Text ingrosat si fundal colorat intens (Background Block)
set -g fish_color_error #ffb4ab --bold --background=#93000a

set -g fish_color_param #c9c5d0
set -g fish_color_comment #928f99
set -g fish_color_selection --background=#35343a
set -g fish_color_search_match --background=#35343a
set -g fish_color_operator #c8bfff
set -g fish_color_escape #5e5791
set -g fish_color_autosuggestion #928f99
set -g fish_color_cancel #93000a
