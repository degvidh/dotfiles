# Temă completă Fish generată automat de Matugen
set -g fish_color_normal #dee3e5
set -g fish_color_command #82d3e0 --bold
set -g fish_color_keyword #bac6ea
set -g fish_color_quote #b1cbd0
set -g fish_color_redirection #b1cbd0
set -g fish_color_end #899294

# Aici fortam vizibilitatea erorilor: Text ingrosat si fundal colorat intens (Background Block)
set -g fish_color_error #ffb4ab --bold --background=#93000a

set -g fish_color_param #bfc8ca
set -g fish_color_comment #899294
set -g fish_color_selection --background=#303637
set -g fish_color_search_match --background=#303637
set -g fish_color_operator #82d3e0
set -g fish_color_escape #006874
set -g fish_color_autosuggestion #899294
set -g fish_color_cancel #93000a
