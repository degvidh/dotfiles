#!/usr/bin/env python3
"""Refresh Hyprlock colors from Quickshell's current theme, then lock.

Style: blurred live screenshot backdrop + a clean centered stack
(time, date, password field). Set LOCK_SCREEN_NOLOCK=1 to only
regenerate the config without locking.

NOTE: the boot login screen (noctalia greeter) is configured separately,
see /var/lib/noctalia-greeter/greeter.toml.
"""

import json
import os
import re
import sys
from pathlib import Path

HOME = Path.home()
PALETTE = HOME / ".config/quickshell/palette.json"
CONFIG = HOME / ".config/hypr/hyprlock.conf"


def rgba(name: str, fallback: str, alpha: float = 1.0) -> str:
    """Palette color as an `rgba(r, g, b, a)` string."""
    value = palette.get(name, fallback)
    match = re.fullmatch(r"#?([0-9a-fA-F]{6})", str(value).strip())
    if not match:
        value = fallback
        match = re.fullmatch(r"#?([0-9a-fA-F]{6})", value)
    rgb = match.group(1)
    channels = [int(rgb[index:index + 2], 16) for index in (0, 2, 4)]
    return f"rgba({channels[0]}, {channels[1]}, {channels[2]}, {alpha:.2f})"


# ─────────────────────────────────────────────────────────────────────────────
try:
    palette = json.loads(PALETTE.read_text(encoding="utf-8"))
    if not isinstance(palette, dict):
        palette = {}
except (OSError, json.JSONDecodeError):
    palette = {}

soft_text = rgba("text", "#fadbd9", 0.96)
muted = rgba("textMuted", "#e5bdba", 0.85)
accent = rgba("primary", "#ffb3af", 0.90)
field_inner = rgba("background", "#1e0f0e", 0.72)
field_text = rgba("text", "#fadbd9")

CONFIG.write_text(
    f'''# Generated by lock-screen (clean style: blurred screenshot + centered stack).
general {{
    hide_cursor = true
    no_fade_in = false
    no_fade_out = false
}}

background {{
    path = screenshot
    blur_passes = 4
    blur_size = 12
    brightness = 0.34
    vibrancy = 0.10
    noise = 0.015
    contrast = 0.85
}}

label {{
    text = $TIME
    font_family = JetBrains Mono Light
    font_size = 86
    color = {soft_text}
    position = 0, -150
    halign = center
    valign = center
}}

label {{
    text = cmd[update:60000] date +"%A  ·  %B %d"
    font_family = JetBrains Mono
    font_size = 16
    color = {muted}
    position = 0, -94
    halign = center
    valign = center
}}

label {{
    text = Welcome back, $USER
    font_family = JetBrains Mono
    font_size = 13
    color = {muted}
    position = 0, 41
    halign = center
    valign = center
}}

input-field {{
    size = 340, 54
    outline_thickness = 1
    outer_color = {accent}
    inner_color = {field_inner}
    font_color = {field_text}
    font_family = JetBrains Mono
    placeholder_text = Password
    fade_on_empty = false
    rounding = 24
    position = 0, 95
    halign = center
    valign = center
}}
''',
    encoding="utf-8",
)
CONFIG.chmod(0o600)

if os.environ.get("LOCK_SCREEN_NOLOCK"):
    print(f"config written: {CONFIG}")
    sys.exit(0)

os.execvp("hyprlock", ["hyprlock"])
