#!/usr/bin/env python3
"""Return a cached, small preview image for a wallpaper."""

import hashlib
import subprocess
import sys
from pathlib import Path


def main():
    if len(sys.argv) != 2:
        raise SystemExit("Usage: qs-wallpaper-thumbnail /path/to/image")

    source = Path(sys.argv[1]).expanduser().resolve()
    if not source.is_file():
        print("", end="")
        return

    stat = source.stat()
    token = f"{source}\0{stat.st_mtime_ns}\0{stat.st_size}".encode()
    key = hashlib.sha256(token).hexdigest()
    cache = Path.home() / ".cache/quickshell/wallhaven-thumbnails"
    target = cache / f"{key}.jpg"
    cache.mkdir(parents=True, exist_ok=True)

    if not target.is_file():
        temporary = cache / f"{key}.tmp.jpg"
        result = subprocess.run(
            [
                "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
                "-i", str(source), "-vf",
                "scale=480:300:force_original_aspect_ratio=increase,crop=480:300",
                "-frames:v", "1", "-q:v", "5", str(temporary),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=30,
            check=False,
        )
        if result.returncode == 0 and temporary.is_file() and temporary.stat().st_size:
            temporary.replace(target)
        else:
            temporary.unlink(missing_ok=True)
            print(source)
            return

    print(target)


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.SubprocessError):
        if len(sys.argv) == 2:
            print(Path(sys.argv[1]).expanduser())
